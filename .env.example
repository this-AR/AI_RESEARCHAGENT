# Required for a live run. Obtain values from your provider account.
# LLM_MODEL takes a provider prefix (gemini/..., groq/...); a bare name defaults to Groq.
LLM_API_KEY=
LLM_MODEL=

# Optional: used when the primary model keeps failing with rate limits, overload or timeouts.
# The key defaults to LLM_API_KEY, so set it when the fallback is another provider.
# LLM_FALLBACK_MODEL=groq/llama-3.3-70b-versatile
# LLM_FALLBACK_API_KEY=

# Optional: enables Serper search. Without it, the local search adapter is used.
SERPER_API_KEY=

# Runtime settings
RESEARCH_OUTPUT_DIR=outputs
RESEARCH_MAX_RPM=5
RESEARCH_VERBOSE=false
